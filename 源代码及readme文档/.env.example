# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，严禁提交。
#
# 真实 LLM 后端（OpenAI 兼容平台，make_model 已通用化为 "!= mock" 即走真实 API）。
# 默认配置走 VectorEngine 平台（configs/vectorengine.yaml 指定 api_key_env=VECTORENGINE_API_KEY）。
# 切换其他 OpenAI 兼容平台只需改 YAML 的 api_base/api_key_env/model，无需改代码。
VECTORENGINE_API_KEY=

# 历史：Paratera 算力平台（账户已失效，保留字段供回退）
PARATERA_API_KEY=
